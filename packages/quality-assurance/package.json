{
  "name": "@develoz/quality-assurance",
  "version": "0.2.2",
  "description": "Opinionated quality-assurance CLI: fail-fast pipeline, run lock, coverage and security gates. Port of rails-quality-assurance.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/develoz-com/js-quality-assurance.git"
  },
  "homepage": "https://github.com/develoz-com/js-quality-assurance",
  "bugs": {
    "url": "https://github.com/develoz-com/js-quality-assurance/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "qa": "./bin/qa.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@develoz/quality-assurance-config": "workspace:*",
    "dependency-cruiser": "^18.5.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "stylelint": "^17.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
