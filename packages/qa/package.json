{
  "name": "@develoz/qa",
  "version": "0.1.0",
  "description": "Opinionated quality-assurance CLI: fail-fast pipeline, run lock, coverage and security gates. Port of rails-quality-assurance.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "qa": "./bin/qa.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
